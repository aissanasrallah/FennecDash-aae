# Normalize line endings in the repository; keep binary assets untouched.
* text=auto
*.php   text eol=lf
*.js    text eol=lf
*.css   text eol=lf
*.scss  text eol=lf
*.md    text eol=lf
*.json  text eol=lf
*.jsonc text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.html  text eol=lf
*.xml   text eol=lf
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.webp  binary
*.pdf   binary
*.zip   binary
*.gz    binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.eot   binary
*.mp3   binary
*.mp4   binary
graphify-out/graph.json filter=lfs diff=lfs merge=lfs -text
