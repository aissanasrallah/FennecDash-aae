# ---------------------------------------------------------------------------
# FennecDash local environment
# ---------------------------------------------------------------------------
# Copy this file to .env and fill in the real values.
# .env is ignored by Git and must never be committed.
#
# Generate an encryption key with:
#   php -r "echo bin2hex(random_bytes(16));"
# ---------------------------------------------------------------------------

APP_BASE_URL=http://localhost/FennecDash5.4/
APP_ENC_KEY=replace-with-a-32-character-random-string

APP_DB_HOSTNAME=localhost
APP_DB_USERNAME=root
APP_DB_PASSWORD=
APP_DB_NAME=fennecdash54
APP_DB_CHARSET=utf8mb4
APP_DB_COLLATION=utf8mb4_unicode_ci

SESS_DRIVER=database
SESS_SAVE_PATH=sessions
APP_SESSION_COOKIE_SAME_SITE=Lax

APP_CSRF_PROTECTION=true
APP_COOKIE_HTTPONLY=true
APP_SESSION_REGENERATE_DESTROY=true

DEMO_MODE=false

# ---------------------------------------------------------------------------
# FennecDash Agent API (used by the MCP server)
# ---------------------------------------------------------------------------
# One-shot installer key. Remove or leave empty to disable /api/setup/*.
# Generate with: php -r "echo bin2hex(random_bytes(24));"
MCP_SETUP_KEY=

# Requests per minute allowed per API token (0 disables the limiter).
MCP_RATE_LIMIT=120

# Raw read-only SQL through /api/v1/database_query. Keep 0 unless needed.
MCP_ALLOW_SQL=0

