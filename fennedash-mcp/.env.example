# ---------------------------------------------------------------------------
# FennecDash MCP - configuration template
# Copy to .env and fill in real values. Never commit .env.
# ---------------------------------------------------------------------------

# FennecDash base URL (no trailing slash; a trailing /api or /api/v1 is accepted)
FENNEDASH_BASE_URL=https://crm.example.com

# Bearer token issued by the FennecDash setup endpoint.
#   POST /api/setup/token  (X-Setup-Key: $MCP_SETUP_KEY)
# Required for stdio. With the HTTP transport each client sends its own token.
FENNEDASH_API_TOKEN=

# Transport: stdio (local agents) or http (remote agents)
MCP_TRANSPORT=stdio

# Streamable HTTP settings (used when MCP_TRANSPORT=http)
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=8765
# Comma-separated Origin headers allowed from browser clients.
# Empty accepts the header without adding CORS response headers.
MCP_ALLOWED_ORIGINS=
# Comma-separated Host headers allowed by the HTTP transport.
# Empty permits any host when bound beyond loopback, and loopback host names
# when MCP_HTTP_HOST is 127.0.0.1, ::1 or localhost.
MCP_ALLOWED_HOSTS=

# Authorization ceilings enforced by the MCP server in addition to the
# backend token risk level. Both default to false.
MCP_ALLOW_WRITE=false
MCP_ALLOW_CRITICAL=false

# Per-request timeout (ms), per-session tool call limit (0 = unlimited) and
# idle HTTP session lifetime (minutes).
MCP_REQUEST_TIMEOUT_MS=30000
MCP_MAX_CALLS_PER_SESSION=0
MCP_SESSION_TTL_MINUTES=120

# Audit trail: JSON Lines file. Empty disables file logging.
MCP_AUDIT_LOG=./logs/audit.jsonl
# Rotate audit log when it exceeds this many bytes. 0 disables rotation.
MCP_AUDIT_MAX_BYTES=10485760

# log level: debug | info | warn | error
MCP_LOG_LEVEL=info

# HTTP transport bearer validation cache TTL (seconds, 0 disables caching)
MCP_AUTH_CACHE_TTL=60

# Production hardening (HTTP transport)
# Public base URL used in production readiness checks (https://...).
# Required when MCP_ENV=production and MCP_TRANSPORT=http.
MCP_PUBLIC_BASE_URL=
# Trust X-Forwarded-* headers from a reverse proxy for client IP and host checks.
MCP_TRUST_PROXY=false
# Maximum request body size (bytes). Default 4 MiB.
MCP_MAX_BODY_BYTES=4194304
# Maximum concurrent HTTP sessions. Default 100.
MCP_MAX_SESSIONS=100
# Readiness cache lifetime (ms). Default 5000.
MCP_READY_CACHE_MS=5000
# Graceful shutdown timeout (ms). Default 10000.
MCP_SHUTDOWN_TIMEOUT_MS=10000

# Environment: development or production (enables production config validation).
MCP_ENV=development
